# Replace with a long unique secret; never commit the real value.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET

# AOVX device ingress. Keep loopback until deliberately preparing a controlled pilot.
TCP_PROTOCOL=raw
TCP_BIND_ADDRESS=127.0.0.1
# Optional operator-only read API token (32-512 URL-safe characters). Leave empty to disable.
AOVX_OBSERVATIONS_TOKEN=

# Synthetic telemetry only; keep false for ordinary raw-capture deployments.
ENABLE_FIXTURE_ADAPTER=false

# Gateway-served same-origin workspace and server simulation are explicit opt-ins.
ENABLE_WEB_WORKSPACE=false
ENABLE_SERVER_SIMULATOR=false
PUBLIC_ORIGIN=http://127.0.0.1:8080

# disabled by default. test creates labeled local receipts, never blockchain TXIDs.
PROOF_MODE=disabled
# Live uses an explicit private-node/secret-file override; see docs/MINIMA_PROOF_ENGINE.md.

# Explicit Mainnet safety gates, still disabled above.
PROOF_ALLOW_LIVE=false
PROOF_ALLOW_MAINNET=false
PROOF_MAX_PUBLICATIONS=1
# PROOF_JOB_SIGNING_KEY_FILE=/absolute/private/p256-job-signer.pem

# Native APK sessions; expose only through authenticated-owner pairing over HTTPS.
ENABLE_NATIVE_CLIENTS=false
# Server Core adapter only (Android jobs select BlackBear independently).
MINIMA_CORE_PROFILE=classic-1.0.49.4
