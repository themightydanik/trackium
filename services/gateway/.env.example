# Replace with a long unique random secret; never commit the real value.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
# Synthetic telemetry only; keep false for ordinary raw-capture deployments.
ENABLE_FIXTURE_ADAPTER=false

# Gateway-served same-origin workspace and server simulation are explicit opt-ins.
ENABLE_WEB_WORKSPACE=false
ENABLE_SERVER_SIMULATOR=false
PUBLIC_ORIGIN=http://127.0.0.1:8080
